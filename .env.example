UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
ADMIN_PASSWORD=admin123
EVENT_DATE=3 de junho
PIX_KEY=espetodoterceirao@pix.com
PIX_NAME=Espetão do Terceirão

# E-mail (Resend - https://resend.com)
# 1. Crie conta gratis em resend.com
# 2. Va em API Keys e gere uma chave
# 3. Use onboarding@resend.dev como FROM (ou verifique seu dominio)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
SMTP_FROM_NAME=3° Ano - Não Responda

# Admins notificados por e-mail (gerenciado pelo painel admin, não precisa de env)

# Web Push (VAPID) - gere com: npx web-push generate-vapid-keys
# NEXT_PUBLIC_ = disponível no frontend
VAPID_SUBJECT=mailto:espeto.terceirao@gmail.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=cole-a-chave-publica-aqui
VAPID_PRIVATE_KEY=cole-a-chave-privada-aqui

# URL base do site (usado nos e-mails e push)
NEXT_PUBLIC_BASE_URL=https://seu-site.vercel.app
