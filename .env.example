NEXT_PUBLIC_VAPID_PUBLIC_KEY=cole-a-chave-publica-aqui
VAPID_PRIVATE_KEY=cole-a-chave-privada-aqui

# URL base do site
NEXT_PUBLIC_BASE_URL=https://seu-site.vercel.app
