UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
ADMIN_PASSWORD=admin123
EVENT_DATE=3 de junho
PIX_KEY=espetodoterceirao@pix.com
PIX_NAME=Espetão do Terceirão

# E-mail (Brevo - https://brevo.com)
# 1. Crie conta gratis em brevo.com
# 2. Confirme seu email
# 3. Settings > API Keys > gere uma chave
# 4. Senders > Add a Sender > adicione seu email
BREVO_API_KEY=cole-sua-api-key-aqui
BREVO_FROM_EMAIL=seuemail@gmail.com
BREVO_FROM_NAME=3 Ano - Nao Responda

# Web Push (VAPID) - gere com: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:seuemail@gmail.com
VAPID_PUBLIC_KEY=cole-a-chave-publica-aqui
NEXT_PUBLIC_VAPID_PUBLIC_KEY=cole-a-chave-publica-aqui
VAPID_PRIVATE_KEY=cole-a-chave-privada-aqui

# URL base do site
NEXT_PUBLIC_BASE_URL=https://seu-site.vercel.app
