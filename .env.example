UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
ADMIN_PASSWORD=admin123
EVENT_DATE=3 de junho
PIX_KEY=espetodoterceirao@pix.com
PIX_NAME=Espetão do Terceirão

# E-mail (Gmail com senha de app)
# 1. Crie espeto.terceirao@gmail.com (ou use seu Gmail pessoal)
# 2. Ative 2FA em https://myaccount.google.com/security
# 3. Gere senha de app em https://myaccount.google.com/apppasswords
SMTP_USER=espeto.terceirao@gmail.com
SMTP_PASS=sua-senha-de-app-aqui
SMTP_FROM_NAME=3° Ano - Não Responda

# E-mail do admin (pode ser o mesmo que o SMTP_USER)
ADMIN_EMAIL=espeto.terceirao@gmail.com

# Web Push (VAPID) - gere com: npx web-push generate-vapid-keys
# NEXT_PUBLIC_ = disponível no frontend
VAPID_SUBJECT=mailto:espeto.terceirao@gmail.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=cole-a-chave-publica-aqui
VAPID_PRIVATE_KEY=cole-a-chave-privada-aqui

# URL base do site (usado nos e-mails e push)
NEXT_PUBLIC_BASE_URL=https://seu-site.vercel.app
